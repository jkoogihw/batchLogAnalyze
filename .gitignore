# ==============================================================================
# Eclipse IDE Specific Configuration & Ignores
# ==============================================================================
# Eclipse Compiled Class Output Directories
/bin/
bin/default/
bin/main/
bin/test/
/out/
/dist/

# Eclipse Workspace & Local Cache
.metadata/
.recommenders/
.sts4-cache/
.gradletasknamecache
.factorypath
.apt_generated/
.apt_generated_tests/
.externalToolBuilders/
.loadpath

# Eclipse Settings: Only track project-wide JDT compiler preferences
.settings/*
!.settings/org.eclipse.jdt.core.prefs

# Eclipse Shared Run Configurations (Keep shared launch files, ignore personal ones)
*.launch
!/CheckLog.launch
!/CheckLogTest.launch

# (Note: .project and .classpath are tracked for offline air-gapped network import)

# ==============================================================================
# IntelliJ IDEA & VS Code Ignores
# ==============================================================================
.idea/
.vscode/
*.iml
*.iws
*.ipr

# ==============================================================================
# Gradle & Maven Build Artifacts
# ==============================================================================
.gradle/
build/
target/
gradle-app.setting

# ==============================================================================
# JAR & Library Handling (Include offline libs & wrapper)
# ==============================================================================
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!/gradlew
!/gradlew.bat
!/gradle/wrapper/
!/gradle/wrapper/**
!/libs/*.jar

# ==============================================================================
# Batch Analysis Output & Logs
# ==============================================================================
/report/
/_analysis/
/_로그분석/
로그분석결과_*.md
*.log
!src/test/resources/**/*.log
src/test/resources/log_monthly/

# ==============================================================================
# Operating System & Temporary Files
# ==============================================================================
.DS_Store
Thumbs.db
ehthumbs.db
*.swp
*.swo
*~
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
