2026-08-22 08:03:55.855 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMRM1010.findMinMaxBsnsDay */

     	SELECT
			DATE_FORMAT(A.BSNS_DATE,'%Y%m%d') AS BSNS_YMD
			, DATE_FORMAT(A.BSNS_DATE,'%Y%m') AS BSNS_YM
			, RANK() OVER(PARTITION BY DATE_FORMAT(A.BSNS_DATE,'%Y%m') ORDER BY A.BSNS_DATE DESC) AS BSNS_RK
			, A.BSNS_DAY_YN
		FROM TB_SMCO1801 A
		WHERE A.BSNS_DATE BETWEEN DATE_FORMAT(DATE_ADD(LAST_DAY(?- INTERVAL 2 MONTH), INTERVAL 1 DAY), '%Y-%m-%d') AND DATE_FORMAT(LAST_DAY(?), '%Y-%m-%d')
