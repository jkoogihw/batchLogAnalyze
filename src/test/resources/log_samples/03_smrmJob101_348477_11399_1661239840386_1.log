			AND (T1.POLR_TLNO IS NOT NULL OR T1.POLR_TLNO != '' OR T1.POLR_TLNO != '--')
		)
		UPDATE TB_SMRM1010 I
		SET I.IMSM_PRGS_STTS_CODE = '00'
		, I.LAST_CHNG_USER_ID = 'BATCH'
		, I.LAST_CHNG_DTTM = NOW()
		, I.LAST_CHNG_PRGM_ID = 'SmrmJob101001Tasklet'
		WHERE I.IMSM_MGMT_UUID IN ( SELECT IMSM_MGMT_UUID FROM RDATA )
