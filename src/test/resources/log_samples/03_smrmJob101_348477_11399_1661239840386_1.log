					,(
						SELECT
							CONCAT(IFNULL(NULLIF(C.HP_BSMN_NO, ""), C2.HP_BSMN_NO) ,IFNULL(NULLIF(C.HP_OFNO, ""), C2.HP_OFNO),IFNULL(NULLIF(C.HP_INNO, ""),C2.HP_INNO) ) AS POLR_TLNO
						FROM TB_SMHO1001 H1
						INNER JOIN TB_SMHO1002 H2 ON H1.UNIQ_NO = P.RCRT_FP_UNIQ_NO AND H2.PSAF_ID = H1.PSAF_ID AND H2.ISRN_CMPY_CODE = P.ISRN_CMPY_CODE
						INNER JOIN TB_SMCR0801 C ON C.CPCP_FP_UNIQ_NO = H2.CPCP_FP_UNIQ_NO AND C.CPCP_CUST_ID = P.POLR_CUST_ID
						LEFT JOIN TB_SMCR0501 C1 ON C1.FP_UNIQ_NO = H1.UNIQ_NO AND C1.CPCP_CUST_ID = P.POLR_CUST_ID AND C1.ISRN_CMPY_CODE = 'L01' AND C1.CUST_ID IS NOT NULL AND C1.FP_UNIQ_NO IS NOT NULL AND C1.CPCP_CUST_ID IS NOT NULL
						LEFT JOIN TB_SMCR0101 C2 ON C2.FP_UNIQ_NO = C1.FP_UNIQ_NO AND C2.CUST_ID = C1.CUST_ID AND C2.FP_UNIQ_NO IS NOT NULL AND C2.CUST_ID IS NOT NULL
