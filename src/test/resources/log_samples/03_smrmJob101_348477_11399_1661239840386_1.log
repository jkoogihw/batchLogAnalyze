2026-08-22 08:03:56.036 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMRM1010.insertNewImsmList */

		 
			 
				INSERT INTO TB_SMRM1010 (
				    IMSM_MGMT_UUID
				  , POLY_NO
				  , ISRN_CMPY_CODE
				  , IMSM_PRGS_STTS_CODE
				  , MEMO_CNTN
				  , IMSM_CNFM_RSLT_CODE
				  , IMSM_CUST_CNFM_DATE
				  , SELF_CTFN_DTTM
				  , IMSM_LAST_LTRS_SEND_CTNB
				  , RGST_USER_ID
				  , RGST_DTTM
				  , RGST_PRGM_ID
				  , LAST_CHNG_USER_ID
				  , LAST_CHNG_DTTM
				  , LAST_CHNG_PRGM_ID
				)
				WITH WDAY AS (
					SELECT
						A.BSNS_DATE
						,RANK() OVER(ORDER BY A.BSNS_DATE DESC) RK
						,A.BSNS_DAY_YN
						,(SELECT COUNT(1) FROM TB_SMCO1801 WHERE BSNS_DATE BETWEEN DATE_FORMAT(A.BSNS_DATE, '%Y%m%d') AND LAST_DAY(A.BSNS_DATE) AND BSNS_DAY_YN = 'Y') AS BSNS_CNT
					FROM TB_SMCO1801 A
					WHERE A.BSNS_DATE BETWEEN DATE_FORMAT(DATE_ADD(LAST_DAY(? - INTERVAL 2 MONTH), INTERVAL 1 DAY), '%Y-%m-%d') AND DATE_FORMAT(LAST_DAY(?), '%Y-%m-%d')
				)
				,RDATA AS (
					SELECT
						P.POLY_NO
			  			,P.ISRN_CMPY_CODE
			  			,H.PSAF_ID
			  			, (
				  			/* 01/22 불완전판매 추출 시 더이상 전화번호를 수집하지 않으나 SMS 발송가능/발송불가 확인 */
							SELECT
								CONCAT(D.HP_BSMN_NO, '-', D.HP_OFNO, '-', D.HP_INNO)
					  		FROM (
								SELECT
									P.RCRT_FP_UNIQ_NO as FP_UNIQ_NO
									,C.CUST_NM
									,IFNULL(NULLIF(C.HP_BSMN_NO, ""), C2.HP_BSMN_NO) AS HP_BSMN_NO
									,IFNULL(NULLIF(C.HP_OFNO, ""), C2.HP_OFNO) AS HP_OFNO
									,IFNULL(NULLIF(C.HP_INNO, ""), C2.HP_INNO) AS HP_INNO
				                FROM TB_SMHO1001 H1
				                INNER JOIN TB_SMHO1002 H2
				                ON H1.UNIQ_NO = P.RCRT_FP_UNIQ_NO
				                AND H2.PSAF_ID = H1.PSAF_ID
				                AND H2.ISRN_CMPY_CODE = P.ISRN_CMPY_CODE
				                INNER JOIN TB_SMCR0801 C
			                 	ON C.CPCP_FP_UNIQ_NO = H2.CPCP_FP_UNIQ_NO
			                 	AND C.CPCP_CUST_ID = P.POLR_CUST_ID
				                LEFT JOIN TB_SMCR0501 C1
				                ON C1.FP_UNIQ_NO = H1.UNIQ_NO
				                AND C1.CPCP_CUST_ID = P.POLR_CUST_ID
				                AND C1.ISRN_CMPY_CODE = 'L01'
				                AND C1.CUST_ID IS NOT NULL
				                AND C1.FP_UNIQ_NO IS NOT NULL
				                AND C1.CPCP_CUST_ID IS NOT NULL
				                LEFT JOIN TB_SMCR0101 C2
				                ON C2.FP_UNIQ_NO = C1.FP_UNIQ_NO
				                AND C2.CUST_ID = C1.CUST_ID
				                AND C2.FP_UNIQ_NO IS NOT NULL
				                AND C2.CUST_ID IS NOT NULL
			 		  		) D LIMIT 1
			       		) AS POLR_TLNO
					FROM TB_SMPM0101 P
					LEFT JOIN TB_SMRM1010 I
					ON P.POLY_NO = I.POLY_NO
					AND P.ISRN_CMPY_CODE = I.ISRN_CMPY_CODE
					LEFT JOIN TB_SMCR0101 C
					ON P.RCRT_FP_UNIQ_NO = C.FP_UNIQ_NO
					AND P.POLR_CUST_ID = C.CUST_ID
					LEFT JOIN TB_SMHO1001 H
					ON P.RCRT_FP_UNIQ_NO = H.UNIQ_NO
					LEFT JOIN WDAY WD
					ON P.CNTC_DATE = WD.BSNS_DATE

					/*공통 조건*/
					WHERE 1=1
				   	AND P.CNTC_DATE  >=  '2022-09-01'
				    AND P.CNTC_DATE  >=  DATE_SUB(DATE_FORMAT(?, '%Y-%m-%d') , INTERVAL 1 WEEK)
					AND P.CNTC_STTS_CODE IN ('00', '98')  /* 정상, 접수 계약 */
					AND P.ISRN_CMPY_CODE = 'L01' /* 한화생명보험인 것만 대상, 다른 보험사는 기준 재정립 필요 */
					AND DATEDIFF(P.CNTC_DATE , P.ORGL_GRTE_TERM_STAR_DATE)  <  30 /* 원보장기간시작일자와 계약일자 비교 */

					/*생명보험 조건*/
				    AND (
						(P.ISRN_CMPY_CODE LIKE 'L%' AND P.PDGR_LGCF_CODE = 'LA' AND P.CNTC_DATE BETWEEN ? AND ?)
				    	 
				         OR
				         (P.ISRN_CMPY_CODE LIKE 'L%' AND P.PDGR_LGCF_CODE = 'LA' AND P.SUM_PREM  >=  500000)
				       )

				    /*불완전판매 대상 등록 조건*/
					AND I.IMSM_MGMT_UUID IS NULL /* 불판 등록 안된 건 */
				)
				SELECT REGEXP_REPLACE(UUID(), '-', '') IMSM_MGMT_UUID
					 , POLY_NO
					 , ISRN_CMPY_CODE
					 , CASE WHEN (DD.PSAF_ID IS NULL OR DD.POLR_TLNO IS NULL OR DD.POLR_TLNO = '' OR DD.POLR_TLNO = '--') THEN
			                '93'
			            ELSE '00'
			            END AS IMSM_PRGS_STTS_CODE
			         , CASE WHEN (DD.PSAF_ID IS NULL) THEN '모집자정보 없는 경우'
			          		WHEN (DD.POLR_TLNO IS NULL OR DD.POLR_TLNO = '' OR DD.POLR_TLNO = '--') THEN '계약자정보 없거나 계약자가 회사인 경우'
			            ELSE NULL
			            END AS MEMO_CNTN
				     , NULL IMSM_CNFM_RSLT_CODE
				     , NULL IMSM_CUST_CNFM_DATE
					 , NULL SELF_CTFN_DTTM
					 , '0' AS IMSM_LAST_LTRS_SEND_CTNB
				     , 'Batch' RGST_USER_ID
				     , NOW() RGST_DTTM
				     , 'SmrmJob101002Tasklet' RGST_PRGM_ID
				     , 'Batch' LAST_CHNG_USER_ID
				     , NOW() LAST_CHNG_DTTM
				     , 'SmrmJob101002Tasklet' LAST_CHNG_PRGM_ID
				  FROM RDATA DD
