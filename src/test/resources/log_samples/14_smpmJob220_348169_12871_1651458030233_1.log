2026-08-22 05:15:56.749 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMPM0613.insertLogProductCompareNew */

        INSERT INTO TB_SMPM0613L
                  ( CLSN_DATE
                    , HGRN_ISRN_CMPY_CODE
