2026-08-22 05:15:52.123 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMPM0613.insertProdRcmdListByTable */

	/* 상비서 추천비교상품 등록 */
	INSERT INTO TB_SMPM0613(
		   HGRN_ISRN_CMPY_CODE
		   , HGRN_PROD_ID
		   , CPPD_ISRN_CMPY_CODE
		   , CPPD_PROD_ID
		   , CPPD_PROD_NM
		   , CPPD_PDGR_LGCF_CODE
		   , CPPD_PDGR_MDCF_CODE
		   , FILE_URL_ADDR
		   , CORT_CHNL_DVSN_VAL
		   , RGST_USER_ID
		   , RGST_DTTM
		   , RGST_PRGM_ID
		   , LAST_CHNG_USER_ID
		   , LAST_CHNG_DTTM
		   , LAST_CHNG_PRGM_ID
    )
    /*5. 최종 조회정보 */
    SELECT HGRN_ISRN_CMPY_CODE
         , HGRN_PROD_ID
         , CPPD_ISRN_CMPY_CODE
         , CPPD_PROD_ID
         , CPPD_PROD_NM
         , CPCP_PDGR_LGCF_CODE
         , CPCP_PDGR_MDCF_CODE
         , FILE_URL_ADDR
         , 'A,B,C,Z' AS CORT_CHNL_DVSN_VAL	/* 제휴채널구분값(미사용 정보 고정값 설정) */
         , ? AS RGST_USER_ID
         , NOW() AS RGST_DTTM
         , ? AS RGST_PRGM_ID
         , ? AS LAST_CHNG_USER_ID
         , NOW() AS LAST_CHNG_DTTM
         , ? AS LAST_CHNG_PRGM_ID
         /*
         , A.ISRN_CMPY_PRIO_ORDR AS RGST_USER_ID
         , NOW() AS RGST_DTTM
         , A.CMPR_AMT AS RGST_PRGM_ID
         , A.CMP_VAL AS LAST_CHNG_USER_ID
         , NOW() AS LAST_CHNG_DTTM
         , 'batch' AS LAST_CHNG_PRGM_ID
         */
      FROM (/* 4. 보험사별 우선상품 조회  */
            SELECT HGRN_ISRN_CMPY_CODE
                 , HGRN_PROD_ID
                 , HGRN_CPCP_PROD_ID
                 , CPPD_ISRN_CMPY_CODE
                 , CPPD_PROD_ID
                 , CPPD_PROD_NM
                 , CPCP_PDGR_LGCF_CODE
                 , CPCP_PDGR_MDCF_CODE
                 , FILE_URL_ADDR
                 , 'A,B,C,Z' AS CORT_CHNL_DVSN_VAL	/* 제휴채널구분값(미사용 정보 고정값 설정) */
                 , ROW_NUMBER() OVER( /* 비교상품보험회사코드 기준 협회상품 1건만 조회 */
                       PARTITION BY A.HGRN_ISRN_CMPY_CODE, A.HGRN_PROD_ID
                           ORDER BY A.CMPR_AMT DESC            /* 우선 : 가중치 */
                                  , A.CMP_VAL DESC             /* 옵션 : 보험료가중치 */
                                  , A.ISRN_CMPY_PRIO_ORDR DESC /* 차선 : 우대보험사 */
                                  , A.SALE_STAR_DATE DESC      /* 후선 : 기간코드 - 판매시작일자 */
                                  , A.PROD_RCMD_STRT_DATE DESC /* 후선 : 기간코드 - 상품추천일자 */
                   ) AS CMPY_RN
                 , COUNT(CASE WHEN A.CMPR_AMT = 111 THEN 1 END)
                        OVER (PARTITION BY A.HGRN_ISRN_CMPY_CODE, A.HGRN_PROD_ID) AS MAX_CNT
                 , COUNT(1)
                        OVER (PARTITION BY A.HGRN_ISRN_CMPY_CODE, A.HGRN_PROD_ID) AS TOT_CNT
                 , A.CMPR_AMT
                 , A.CMP_VAL
                 , A.ISRN_CMPY_PRIO_ORDR
                 , A.SAME_PROD
              FROM (/* 3. 비교상품 우선정보 조회 */
                    SELECT AA.HGRN_ISRN_CMPY_CODE
                         , AA.HGRN_PROD_ID
                         , AA.HGRN_CPCP_PROD_ID
                         , AA.CPPD_ISRN_CMPY_CODE
                         , AA.CPCP_PROD_CODE AS CPPD_PROD_ID
                         , AA.CPCP_PDGR_LGCF_CODE        /* 대분류 */
                         , AA.CPCP_PDGR_MDCF_CODE        /* 중분류 */
                         , AA.CPPD_PROD_NM
                         , AA.FILE_URL_ADDR
                         , AA.SALE_STAR_DATE
                         , AA.PROD_RCMD_STRT_DATE
                         , AA.SAME_PROD
                         , ROW_NUMBER() OVER( /* 비교상품보험회사코드 기준 협회상품 1건만 조회 */
                               PARTITION BY AA.HGRN_ISRN_CMPY_CODE, AA.HGRN_PROD_ID, AA.CPPD_ISRN_CMPY_CODE
                                   ORDER BY AA.SAME_PROD DESC           /* 청약 : 본상품 */
                                          , AA.CMPR_AMT DESC            /* 우선 : 가중치 */
                                          , AA.CMP_VAL DESC             /* 옵션 : 보험료가중치 */
                                          , AA.ISRN_CMPY_PRIO_ORDR DESC /* 차선 : 우대보험사 */
                                          , AA.SALE_STAR_DATE DESC      /* 후선 : 기간코드 - 판매시작일자 */
                                          , AA.PROD_RCMD_STRT_DATE DESC /* 후선 : 기간코드 - 상품추천일자 */
                                          , AA.SALE_END_DATE            /* 후선 : 기간코드 - 판매종료일자 */
                           ) AS RN
                         , CMPR_AMT
                         , CMP_VAL
                         , ISRN_CMPY_PRIO_ORDR
                      FROM (/* 2. 비교상품대상정보 조회 */
                            SELECT (CASE WHEN T1.ASOC_PROD_CODE = T2.CPCP_PROD_CODE
                                         THEN 1 ELSE 0 END ) AS SAME_PROD /* 동일상품 우선정보 */
                                 , T1.ISCM_CODE AS HGRN_ISRN_CMPY_CODE    /* 상위보험회사코드 */
                                 , T1.PROD_ID AS HGRN_PROD_ID	      	  /* 상위상품ID(원수사상품ID) */
                                 , T1.ASOC_PROD_CODE AS HGRN_CPCP_PROD_ID /* 상위상품ID(협회상품ID) */
                                 , T2.ISCM_CODE AS CPPD_ISRN_CMPY_CODE	  /* 비교상품 보험사 코드 */
                                 , T2.CPCP_PROD_CODE                      /* 비교상품코드(협회상품코드) */
                                 , T2.CPCP_PROD_NM AS CPPD_PROD_NM        /* 비교상품명 */
                                 , T2.CPCP_PDGR_LGCF_CODE                 /* 대분류 */
                                 , T2.CPCP_PDGR_MDCF_CODE                 /* 중분류 */
                                 , T2.CPCP_JDGN_DVSN_CODE                 /* 간편심사 */
                                 , T2.CPCP_ATYP_DVSN_CODE                 /* 구분상세A */
                                 , T2.CPCP_BTYP_DVSN_CODE                 /* 구분상세B */
                                 , T2.CPCP_ITRT_MTHO_CODE                 /* 금리방식 */
                                 , T2.PDSM_DNLD_URL_ADDR AS FILE_URL_ADDR /* 파일URL주소 */
                                 , T2.PROD_RCMD_STRT_DATE                 /* 상품추천일자 */
                                 , T2.SALE_STAR_DATE                      /* 판매시작일자 */
                                 , T2.SALE_END_DATE                       /* 판매종료일자 */
                                 , /* 상품 매핑 점수 (CMPR_AMT) 계산로직 : 가중치 적용 */
                                   (CASE WHEN (T2.CPCP_PDGR_LGCF_CODE = T1.CPCP_PDGR_LGCF_CODE
                                          AND T2.CPCP_PDGR_MDCF_CODE = T1.CPCP_PDGR_MDCF_CODE ) THEN 100
                                         ELSE 0 END                       /* 1.대분류, 2.중분류 일치*/
                                  + CASE WHEN (T2.CPCP_JDGN_DVSN_CODE = T1.CPCP_JDGN_DVSN_CODE) THEN 10
                                         ELSE 0 END                       /* 3.간편심사 일치*/
                                  /* + CASE WHEN (T2.CPCP_ATYP_DVSN_CODE = T1.CPCP_ATYP_DVSN_CODE) THEN 1
                                         ELSE 0 END                          4.구분상세A 일치 - [양식변경] 삭제*/
                                  + CASE WHEN (T2.CPCP_BTYP_DVSN_CODE = T1.CPCP_BTYP_DVSN_CODE) THEN 1
                                         ELSE 0 END                       /* 5.구분상세B 일치*/
                                  /* + CASE WHEN (T2.CPCP_PDGR_LGCF_CODE NOT IN ('A','B') 손보(조건무시) */
                                  /*             ) THEN 100
                                         WHEN (T2.CPCP_PDGR_LGCF_CODE IN ('A','B')  생보 */
                                  /*            AND T2.CPCP_ITRT_MTHO_CODE = T1.CPCP_ITRT_MTHO_CODE
                                              ) THEN 100
                                         ELSE 0 END                          11.금리방식 일치 - [양식변경] 삭제 */
                                   ) AS CMPR_AMT
                                 , (/* 보험사 우선 순위 우대설정 (삼성생명[L25], 교보생명[L11]) [양식변경] 보험사변경 */
                                    CASE T2.ISCM_CODE WHEN 'L03' THEN 10  /* 삼성생명 우대(L25 > L03) */
                                                      WHEN 'L05' THEN 9   /* 농협생명 우대(L11 > L05) */
                                                      ELSE 5 END          /* 기본점수 */
                                   ) AS ISRN_CMPY_PRIO_ORDR
                                 , IFNULL(T2.MAN_ACPY_PREM_VAL,0)+0 AS CMP_VAL /* 비교보험료 */
                              FROM ( /* 1. 청약상품(비교기준) 정보 조회 */
                                     SELECT PM0601.PROD_ID                /* 상품ID(원수사상품ID) */
                                          , PM0601.ASOC_PROD_CODE
                                          , PM0620.CPCP_PROD_CODE
                                          , PM0620.ISCM_CODE
                                          , PM0620.CPCP_PDGR_LGCF_CODE
                                          , PM0620.CPCP_PDGR_MDCF_CODE
                                          , PM0620.CPCP_JDGN_DVSN_CODE
                                          , PM0620.CPCP_ATYP_DVSN_CODE
                                          , PM0620.CPCP_BTYP_DVSN_CODE
                                          , PM0620.CPCP_CPPD_UL_CODE
                                          , PM0620.CPCP_ITRT_MTHO_CODE
                                          , PM0620.MAN_ACPY_PREM_VAL
                                       FROM TB_SMPM0601 PM0601 	/* PM_상품임시 */
                                       JOIN TB_SMPM0620 PM0620 	/* PM_협회상품데이터적재 */
                                         ON PM0601.ASOC_PROD_CODE = PM0620.CPCP_PROD_CODE
                                      WHERE PM0601.ISRN_CMPY_CODE IN ('L01', 'N02')	   /* 추천보험사 [한화생명, 한화손보] */
                                        AND PM0601.USE_YN = 'Y'                        /* 사용여부 */
                                        AND PM0601.SALE_STAR_DATE  <=  NOW() /* 판매시작일자 */
                                        AND PM0601.SALE_END_DATE  >=  NOW()  /* 판매종료일자 */
                                        AND PM0601.ASOC_PROD_CODE !=''                 /* 협회상품코드 */
                                        AND PM0620.CPCP_PDGR_MDCF_CODE != 'C012'       /* 중분류 : 자동차 제외 */
                                        AND PM0620.PROD_REVS_VRSN_NO = 1
                                   ) T1
                              JOIN /* 2. 협회상품 데이터(TB_SMPM0620)와 청약상품정보 비교 및 점수 산출 */
                                   TB_SMPM0620 T2
                                ON T2.CPCP_PDGR_LGCF_CODE = T1.CPCP_PDGR_LGCF_CODE
                               AND T2.CPCP_PDGR_MDCF_CODE = T1.CPCP_PDGR_MDCF_CODE
                             WHERE T2.CPCP_PDGR_MDCF_CODE != 'C012'            /* 중분류 : 자동차 제외 : 자동차 보험상품에 협회상품 매핑하지 않으면 비교상품에도 대상에서 제외 되지만, 명시적으로 제거*/
                               AND T1.ISCM_CODE IN ('L01','N02')               /* 한생(L34>L01), 한손(N09>N02) [양식변경] 보험사코드 현행화 */
                               AND T2.SALE_STAR_DATE  <=  NOW()      /* 7.판매시작일자 */
                               AND T2.PROD_RCMD_STRT_DATE  <=  NOW() /* 7.판매시작일자 */
                               AND (CASE WHEN T1.ASOC_PROD_CODE != T2.CPCP_PROD_CODE
                                         THEN (T2.SALE_END_DATE IS NULL OR T2.SALE_END_DATE  >=  NOW())
                                         ELSE 1=1 END)                         /* 8.판매종료일자 */
                               AND T2.PROD_REVS_VRSN_NO = 1
                           )  AA
                     ORDER BY AA.SAME_PROD DESC           /* 청약보험여부 */
                            , AA.CMPR_AMT DESC            /* 비교가중치 */
                            , AA.CMP_VAL DESC             /* 보험료차액 */
                            , AA.ISRN_CMPY_PRIO_ORDR DESC /* 보험사가중치 */
                            , AA.SALE_STAR_DATE DESC      /* 판매시작일자 */
                            , AA.PROD_RCMD_STRT_DATE DESC /* 개시시작일자 */
                            , AA.SALE_END_DATE            /* 판매종료일자 */
                   ) A
             WHERE RN = 1
           ) A
     WHERE CASE WHEN HGRN_CPCP_PROD_ID = CPPD_PROD_ID THEN 1=1   /* (청약상품) */
                WHEN CMPR_AMT = 111 /* AND (CMP_VAL > 0 OR ISRN_CMPY_PRIO_ORDR > 5 ) */ THEN 1=1 /* (충분조건:만족가중치, 높은보험료 | 보험사가중치) */
                /* WHEN CMPY_RN  4 THEN 1=1             (보충조건:충분조건 3건미만) 10.[양식변경] 불충분확대조회 폐기 */
                ELSE 1!=1 END
     ORDER BY A.HGRN_PROD_ID             /* 상품 */
            , A.SAME_PROD DESC           /* 청약상품여부 */
            , A.CMPR_AMT DESC            /* 비교가중치 */
            , A.ISRN_CMPY_PRIO_ORDR DESC /* 보험사 */
            , A.CMP_VAL DESC             /* 보험료 */
