						ELSE TB2.SLCT_JOIN_BASE_RDR_NM1
						END
					) AS SLCT_JOIN_BASE_RDR_NM1
					, IFNULL(TB2.SLCT_JOIN_DETL_RDR_NM1,'') AS  SLCT_JOIN_DETL_RDR_NM1      /* 선택가입상세특약명1 */
					, (CASE SIGN(50-LENGTH(TB2.SLCT_JOIN_BASE_RDR_NM2))
						 WHEN -1 THEN REPLACE(SUBSTR(REGEXP_REPLACE(TB2.SLCT_JOIN_BASE_RDR_NM2, '[^[:ALNUM:][:SPACE:]]+', '') ,1,17),' ','')
