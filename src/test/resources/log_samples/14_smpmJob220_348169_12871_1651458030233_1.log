2026-08-22 05:15:56.705 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMPM0613.updateRcmdPssbIscmListCntn */

	/* updateRcmdPssbIscmListCntn : 추천보험사목록 설정 */
		UPDATE TB_SMPM0613 aa
		  JOIN (
				SELECT HGRN_ISRN_CMPY_CODE
				     , HGRN_PROD_ID
				     , GROUP_CONCAT(CPPD_ISRN_CMPY_NM ORDER BY CPPD_ISRN_CMPY_NM SEPARATOR ',') AS RCMD_PSSB_ISCM_LIST_CNTN
				  FROM (SELECT HGRN_ISRN_CMPY_CODE
							 , HGRN_PROD_ID
							 , bb.INTG_DETL_CODE_NM CPPD_ISRN_CMPY_NM
							 , CPPD_ISRN_CMPY_CODE
							 , CPPD_PROD_ID
						  FROM tb_smpm0613 aa
						  LEFT OUTER JOIN tb_smpm1002 bb
							ON bb.INTG_CODE = 'INSCO_CD'
							AND aa.CPPD_ISRN_CMPY_CODE = bb.INTG_DETL_CODE
						  ORDER BY bb.INTG_DETL_CODE_NM
						) aa
				 GROUP BY HGRN_ISRN_CMPY_CODE, HGRN_PROD_ID
				) bb
		    ON aa.HGRN_ISRN_CMPY_CODE = bb.HGRN_ISRN_CMPY_CODE
		   AND aa.HGRN_PROD_ID = bb.HGRN_PROD_ID
		   SET aa.RCMD_PSSB_ISCM_LIST_CNTN = bb.RCMD_PSSB_ISCM_LIST_CNTN
		 WHERE aa.HGRN_ISRN_CMPY_CODE = aa.CPPD_ISRN_CMPY_CODE
