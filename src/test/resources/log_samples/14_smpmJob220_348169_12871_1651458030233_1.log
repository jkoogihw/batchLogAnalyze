					, IFNULL(TB2.ASOC_PROD_FTUR_CNTN,'') AS ASOC_PROD_FTUR_CNTN             /* 협회상품특징내용 */
					, CASE CPPD_ISRN_CMPY_CODE
							   WHEN 'L01' THEN 1
							   WHEN 'L42' THEN 2
							   WHEN 'L03' THEN 3
							   ELSE  CONCAT('4', REPLACE(CPPD_ISRN_CMPY_CODE,'L',''))
							   END ORD_SEQ
					, IFNULL(TB2.PROD_IDNF_CODE,'') AS PROD_IDNF_CODE
					, IFNULL(TB2.SALE_CMSN_GRAD_CODE_NM,'') AS SALE_CMSN_GRAD_CODE_NM
					, IFNULL(TB2.SALE_CMSN_RNKG,'') AS SALE_CMSN_RNKG
					, IFNULL(TB1.RCMD_PSSB_ISCM_LIST_CNTN,'') AS RCMD_PSSB_ISCM_LIST_CNTN
				FROM TB_SMPM0613 TB1
				JOIN TB_SMPM0620 TB2
				  ON  TB1.CPPD_ISRN_CMPY_CODE = TB2.ISCM_CODE      /* 비교상품보험회사코드 */
				  AND TB1.CPPD_PROD_ID        = TB2.CPCP_PROD_CODE /* 비교상품상품ID */
				WHERE TB1.HGRN_ISRN_CMPY_CODE = 'L01'
			) F
			ORDER BY HGRN_PROD_ID , RNK
		) G
		WHERE RNK  <  4
		ORDER BY HGRN_PROD_ID, ORD_SEQ
	) aa
