			WHERE ISRN_CMPY_CODE = ?
			AND POLY_NO = ?
			AND PCIC_ATCM_YN = 'Y'
			AND DLTN_YN = 'N'
		)A ON M.PCIC_LDNG_ID = A.PCIC_LDNG_ID
		SET
			M.DLTN_YN  = 'Y'
			, M.LAST_CHNG_USER_ID = ?
			, M.LAST_CHNG_DTTM = NOW()
			, M.LAST_CHNG_PRGM_ID = ?
		WHERE A.RN > 1
		AND M.PCIC_LDNG_PATH = ?
