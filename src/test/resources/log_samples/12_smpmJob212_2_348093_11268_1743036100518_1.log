		UPDATE TB_SMPM0624 M
		INNER JOIN (
			SELECT
				ROW_NUMBER() OVER (PARTITION BY ISRN_CMPY_CODE, POLY_NO, PCIC_LDNG_PATH, ATCM_FILE_NM ORDER BY DAT_RFDT DESC, RGST_DTTM DESC ) AS RN
				, PCIC_LDNG_ID
