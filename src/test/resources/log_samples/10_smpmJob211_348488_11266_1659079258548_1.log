2026-08-22 09:28:50.231 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMPM0101.selectPcicRate */

		WITH RECURSIVE CTS_ORG_INFO AS ( /*기관 계층*/
			SELECT
				CLSN_YYMM
				, ORGN_CODE
				, ORGN_NM
				, HGRN_ORGN_CODE
				, 1 ORGN_LEV
				, CAST(ORGN_CODE AS CHAR(1000)) AS ORGN_CODE_PATH
				, CAST(ORGN_NM AS CHAR(1000)) AS ORGN_NM_PATH
			FROM TB_SMHO0002
			WHERE 1=1
			AND DLTN_YN = 'N'
			AND USE_YN = 'Y'
			AND CLSN_YYMM = DATE_FORMAT(STR_TO_DATE(?, '%Y%m%d'), '%Y%m')
			AND HGRN_ORGN_CODE IS NULL
			UNION ALL
			SELECT T1.CLSN_YYMM
				, T1.ORGN_CODE
				, T1.ORGN_NM
				, T1.HGRN_ORGN_CODE
				, CTS.ORGN_LEV + 1
				, CONCAT(CTS.ORGN_CODE_PATH, '>', T1.ORGN_CODE) AS ORGN_CODE_PATH
				, CONCAT(CTS.ORGN_NM_PATH, '>', T1.ORGN_NM) AS ORGN_NM_PATH
			FROM TB_SMHO0002 T1
			INNER JOIN CTS_ORG_INFO CTS
			ON T1.HGRN_ORGN_CODE = CTS.ORGN_CODE
			AND T1.CLSN_YYMM = CTS.CLSN_YYMM
			WHERE T1.DLTN_YN = 'N'
			AND T1.USE_YN = 'Y'
		)
		, CNTC_INFO AS( /*계약 정보*/
			SELECT
				XX.POLY_NO
				,XX.ISRN_CMPY_CODE
				,XX.CNTC_DATE
				,XX.NC_STND_YYMM
				,XX.ORGN_CODE
				,XX.PCIC_BLNG_YN /*상품비교설명확인서 대상여부*/
				,CASE WHEN XX.PCIC_BLNG_YN = 'N' THEN 'X' 									/* X, 비대상(징구제외대상)*/
					  WHEN XX.PCIC_BLNG_YN = 'Y' AND XX.ATCM_FILE_ID IS NOT NULL THEN 'Y' 	/* Y, 첨부파일 등록*/
					  ELSE 'N' 																/* N, 첨부파일 미등록*/
				 END AS PCIC_ATCM_YN /*상품비교설명확인서 등록여부*/
				,CASE WHEN XX.PCIC_BLNG_YN = 'N' THEN 'X' 																								/* X, 비대상(징구제외대상)*/
					  WHEN XX.PCIC_BLNG_YN = 'Y' AND XX.ATCM_FILE_ID IS NOT NULL AND XX.APPN_MTHD_CODE = '01' THEN 'N' 									/* N, 비대상(전자징구), 전자*/
					  WHEN XX.PCIC_BLNG_YN = 'Y' AND XX.ATCM_FILE_ID IS NOT NULL AND (XX.APPN_MTHD_CODE = '02' OR XX.APPN_MTHD_CODE = '03') THEN 'Y'   /* Y, 편철대상, 종이*/
					  ELSE 'Z' 																															/* Z, 알수없음, 대상이지만 첨부파일 없어서 미정*/
				 END AS PCIC_REF_YN /*상품비교설명확인서 편철대상, 징구유형*/
			FROM(SELECT
				TE.POLY_NO
				,TE.ISRN_CMPY_CODE
				,TE.CNTC_DATE
				,TE.NC_STND_YYMM
				,TE.CNTC_STTS_CODE
				,TE.PDGR_LGCF_CODE
				,TE.RCRT_FP_UNIQ_NO
				,IFNULL(TE.RCRT_FP_ORGN_CODE, 'UNKNOWN') AS ORGN_CODE
				,TE3.PROD_CMPR_TRGT_YN
				,TE5.PCIC_BLNG_EXLS_RESN_CODE
				,CASE WHEN(TE.CNTC_DATE >= '2022-06-01'					 	/*계약일자가 20220601 이후면 대상에 해당*/
						AND TE.CNTC_STTS_CODE IN ('00','98') 				/*계약상태가 정상, 접수이면 대상에 해당*/
						AND TE.PDGR_LGCF_CODE IN ('LA','LB','NL','CA') 		/*대분류가 보장성, 연금저축, 장기, 자동차인건 대상에 해당*/
						AND TE.RCRT_FP_UNIQ_NO != 'TRANSFER' 				/*모집FP고유번호가 TRANSFER이면 수금이관건이므로 TRANSFER가 아닌건이 대상에 해당*/
						AND TE3.PROD_CMPR_TRGT_YN = 'Y'						/*상품이 비교대상인 건*/
						AND (TE5.POLY_NO IS NULL OR TE5.PCIC_BLNG_EXLS_RESN_CODE = '00') 							/*상품비교확인서 대상제외 테이블에 없거나 오류로 제외테이블 존재하지만 코드가 00인것 대상에 해당*/
						AND !(TE.PDGR_LGCF_CODE IN ('CA') AND (TE.CNTC_DATE BETWEEN '2022-06-01' AND '2023-06-30')) /*대분류가 자동차이고 계약일자가 20220601~20230630 사이이면 대상건 제외*/
					)THEN 'Y' ELSE 'N'
				 END AS PCIC_BLNG_YN /*비교안내확인서 대상여부*/
				,S2.ATCM_FILE_ID
				,S2.APPN_MTHD_CODE
			FROM TB_SMPM0101 TE   USE INDEX (IE_TB_SMPM0101_06)  
			LEFT JOIN TB_SMPM0601 TE3
				ON (TE3.PROD_ID = TE.PROD_ID)
			LEFT JOIN TB_SMPM0617 TE5
				ON (TE5.POLY_NO = TE.POLY_NO
				AND TE5.ISRN_CMPY_CODE = TE.ISRN_CMPY_CODE)
			LEFT JOIN TB_SMPM0624 S2
				ON S2.DLTN_YN = 'N'
				AND S2.PCIC_ATCM_YN = 'Y'
				AND S2.ISRN_CMPY_CODE = TE.ISRN_CMPY_CODE
				AND S2.POLY_NO = TE.POLY_NO
				AND S2.ATCM_FILE_ID = (SELECT ATCM_FILE_ID FROM TB_SMPM0624 WHERE DLTN_YN = 'N' AND PCIC_ATCM_YN = 'Y' AND ISRN_CMPY_CODE = TE.ISRN_CMPY_CODE AND POLY_NO = TE.POLY_NO LIMIT 1)
			WHERE 1=1
			AND (TE.CNTC_DATE BETWEEN DATE_FORMAT(STR_TO_DATE(?, '%Y%m%d'), '%Y%m01') AND ?)
			)XX
			
		)
		,CNTC_COUNT AS ( /*기관별 전체, 생보, 손보 건수*/
			SELECT
				T1.ORGN_CODE
				,T1.ACML_TOT_CNT
				,T1.ACML_TOT_PCIC_BLNG_Y
				,T1.ACML_TOT_PCIC_ATCM_Y
				,T1.ACML_TOT_PCIC_ATCM_N
				,T1.ACML_TOT_PCIC_REF_N
				,T1.ACML_L00_PCIC_BLNG_Y
				,T1.ACML_L00_PCIC_ATCM_Y
				,T1.ACML_L00_PCIC_ATCM_N
				,T1.ACML_L00_PCIC_REF_N
				,T1.ACML_N00_PCIC_BLNG_Y
				,T1.ACML_N00_PCIC_ATCM_Y
				,T1.ACML_N00_PCIC_ATCM_N
				,T1.ACML_N00_PCIC_REF_N
				,T2.DAY_TOT_CNT
				,T2.DAY_TOT_PCIC_BLNG_Y
				,T2.DAY_TOT_PCIC_ATCM_Y
				,T2.DAY_TOT_PCIC_ATCM_N
				,T2.DAY_TOT_PCIC_REF_N
				,T2.DAY_L00_PCIC_BLNG_Y
				,T2.DAY_L00_PCIC_ATCM_Y
				,T2.DAY_L00_PCIC_ATCM_N
				,T2.DAY_L00_PCIC_REF_N
				,T2.DAY_N00_PCIC_BLNG_Y
				,T2.DAY_N00_PCIC_ATCM_Y
				,T2.DAY_N00_PCIC_ATCM_N
				,T2.DAY_N00_PCIC_REF_N
			FROM
			(
				SELECT
					ORGN_CODE
					,COUNT(PCIC_BLNG_YN) AS ACML_TOT_CNT /*전체건수*/

					,COUNT(CASE WHEN PCIC_BLNG_YN = 'Y' THEN 1 END) AS ACML_TOT_PCIC_BLNG_Y /*전체 대상건수*/
					,COUNT(CASE WHEN PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'Y' THEN 1 END ) AS ACML_TOT_PCIC_ATCM_Y /*전체 등록건수*/
					,COUNT(CASE WHEN PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'N' THEN 1 END ) AS ACML_TOT_PCIC_ATCM_N /*전체 미등록건수*/
					,COUNT(CASE WHEN PCIC_BLNG_YN = 'Y' AND PCIC_REF_YN = 'N' THEN 1 END ) AS ACML_TOT_PCIC_REF_N /*전체 전자징구등록건수*/

					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='L' AND PCIC_BLNG_YN = 'Y' THEN 1 END) AS ACML_L00_PCIC_BLNG_Y /*생보 대상건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='L' AND PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'Y' THEN 1 END ) AS ACML_L00_PCIC_ATCM_Y /*생보 등록건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='L' AND PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'N' THEN 1 END ) AS ACML_L00_PCIC_ATCM_N /*생보 미등록건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='L' AND PCIC_BLNG_YN = 'Y' AND PCIC_REF_YN = 'N' THEN 1 END ) AS ACML_L00_PCIC_REF_N /*생보 전자징구등록건수*/

					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='N' AND PCIC_BLNG_YN = 'Y' THEN 1 END) AS ACML_N00_PCIC_BLNG_Y /*손보 대상건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='N' AND PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'Y' THEN 1 END ) AS ACML_N00_PCIC_ATCM_Y /*손보 등록건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='N' AND PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'N' THEN 1 END ) AS ACML_N00_PCIC_ATCM_N /*손보 미등록건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='N' AND PCIC_BLNG_YN = 'Y' AND PCIC_REF_YN = 'N' THEN 1 END ) AS ACML_N00_PCIC_REF_N /*손보 전자징구등록건수*/
				FROM CNTC_INFO
				GROUP BY ORGN_CODE
			)T1
			LEFT JOIN (
				SELECT
					ORGN_CODE
					,COUNT(PCIC_BLNG_YN) AS DAY_TOT_CNT /*전체건수*/

					,COUNT(CASE WHEN PCIC_BLNG_YN = 'Y' THEN 1 END) AS DAY_TOT_PCIC_BLNG_Y /*전체 대상건수*/
					,COUNT(CASE WHEN PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'Y' THEN 1 END ) AS DAY_TOT_PCIC_ATCM_Y /*전체 등록건수*/
					,COUNT(CASE WHEN PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'N' THEN 1 END ) AS DAY_TOT_PCIC_ATCM_N /*전체 미등록건수*/
					,COUNT(CASE WHEN PCIC_BLNG_YN = 'Y' AND PCIC_REF_YN = 'N' THEN 1 END ) AS DAY_TOT_PCIC_REF_N /*전체 전자징구등록건수*/

					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='L' AND PCIC_BLNG_YN = 'Y' THEN 1 END) AS DAY_L00_PCIC_BLNG_Y /*생보 대상건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='L' AND PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'Y' THEN 1 END ) AS DAY_L00_PCIC_ATCM_Y /*생보 등록건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='L' AND PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'N' THEN 1 END ) AS DAY_L00_PCIC_ATCM_N /*생보 미등록건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='L' AND PCIC_BLNG_YN = 'Y' AND PCIC_REF_YN = 'N' THEN 1 END ) AS DAY_L00_PCIC_REF_N /*생보 전자징구등록건수*/

					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='N' AND PCIC_BLNG_YN = 'Y' THEN 1 END) AS DAY_N00_PCIC_BLNG_Y /*손보 대상건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='N' AND PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'Y' THEN 1 END ) AS DAY_N00_PCIC_ATCM_Y /*손보 등록건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='N' AND PCIC_BLNG_YN = 'Y' AND PCIC_ATCM_YN = 'N' THEN 1 END ) AS DAY_N00_PCIC_ATCM_N /*손보 미등록건수*/
					,COUNT(CASE WHEN SUBSTR(ISRN_CMPY_CODE,1,1) ='N' AND PCIC_BLNG_YN = 'Y' AND PCIC_REF_YN = 'N' THEN 1 END ) AS DAY_N00_PCIC_REF_N /*손보 전자징구등록건수*/
				FROM CNTC_INFO
				WHERE CNTC_DATE = ?
				GROUP BY ORGN_CODE
			)T2 ON T1.ORGN_CODE = T2.ORGN_CODE

		)
		, ORG_CNTC_INFO AS ( /*기관정보 + 계약 건수*/
			SELECT
				T1.ORGN_CODE
				,T1.ORGN_NM
				,T1.ORGN_LEV
				,T1.HGRN_ORGN_CODE
				,IFNULL(T2.ACML_TOT_CNT,0) AS ACML_TOT_CNT
				,IFNULL(T2.ACML_TOT_PCIC_BLNG_Y,0) AS ACML_TOT_PCIC_BLNG_Y
				,IFNULL(T2.ACML_TOT_PCIC_ATCM_Y,0) AS ACML_TOT_PCIC_ATCM_Y
				,IFNULL(T2.ACML_TOT_PCIC_ATCM_N,0) AS ACML_TOT_PCIC_ATCM_N
				,IFNULL(T2.ACML_TOT_PCIC_REF_N,0) AS ACML_TOT_PCIC_REF_N
				,IFNULL(T2.ACML_L00_PCIC_BLNG_Y,0) AS ACML_L00_PCIC_BLNG_Y
				,IFNULL(T2.ACML_L00_PCIC_ATCM_Y,0) AS ACML_L00_PCIC_ATCM_Y
				,IFNULL(T2.ACML_L00_PCIC_ATCM_N,0) AS ACML_L00_PCIC_ATCM_N
				,IFNULL(T2.ACML_L00_PCIC_REF_N,0) AS ACML_L00_PCIC_REF_N
				,IFNULL(T2.ACML_N00_PCIC_BLNG_Y,0) AS ACML_N00_PCIC_BLNG_Y
				,IFNULL(T2.ACML_N00_PCIC_ATCM_Y,0) AS ACML_N00_PCIC_ATCM_Y
				,IFNULL(T2.ACML_N00_PCIC_ATCM_N,0) AS ACML_N00_PCIC_ATCM_N
				,IFNULL(T2.ACML_N00_PCIC_REF_N,0) AS ACML_N00_PCIC_REF_N
				,IFNULL(T2.DAY_TOT_CNT,0) AS DAY_TOT_CNT
				,IFNULL(T2.DAY_TOT_PCIC_BLNG_Y,0) AS DAY_TOT_PCIC_BLNG_Y
				,IFNULL(T2.DAY_TOT_PCIC_ATCM_Y,0) AS DAY_TOT_PCIC_ATCM_Y
				,IFNULL(T2.DAY_TOT_PCIC_ATCM_N,0) AS DAY_TOT_PCIC_ATCM_N
				,IFNULL(T2.DAY_TOT_PCIC_REF_N,0) AS DAY_TOT_PCIC_REF_N
				,IFNULL(T2.DAY_L00_PCIC_BLNG_Y,0) AS DAY_L00_PCIC_BLNG_Y
				,IFNULL(T2.DAY_L00_PCIC_ATCM_Y,0) AS DAY_L00_PCIC_ATCM_Y
				,IFNULL(T2.DAY_L00_PCIC_ATCM_N,0) AS DAY_L00_PCIC_ATCM_N
				,IFNULL(T2.DAY_L00_PCIC_REF_N,0) AS DAY_L00_PCIC_REF_N
				,IFNULL(T2.DAY_N00_PCIC_BLNG_Y,0) AS DAY_N00_PCIC_BLNG_Y
				,IFNULL(T2.DAY_N00_PCIC_ATCM_Y,0) AS DAY_N00_PCIC_ATCM_Y
				,IFNULL(T2.DAY_N00_PCIC_ATCM_N,0) AS DAY_N00_PCIC_ATCM_N
				,IFNULL(T2.DAY_N00_PCIC_REF_N,0) AS DAY_N00_PCIC_REF_N
				,IFNULL(CASE WHEN T1.ORGN_LEV = 1 THEN T1.ORGN_CODE_PATH WHEN T1.ORGN_LEV > 1 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_CODE_PATH,'>',1),'>',-1)) ELSE NULL END,'') ORGN_CODE1
				,IFNULL(CASE WHEN T1.ORGN_LEV = 1 THEN T1.ORGN_NM_PATH WHEN T1.ORGN_LEV > 1 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_NM_PATH,'>',1),'>',-1)) ELSE NULL END,'') ORGN_NM1
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 2 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_CODE_PATH,'>',2),'>',-1)) ELSE NULL END,'') ORGN_CODE2
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 2 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_NM_PATH,'>',2),'>',-1)) ELSE NULL END,'') ORGN_NM2
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 3 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_CODE_PATH,'>',3),'>',-1)) ELSE NULL END,'') ORGN_CODE3
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 3 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_NM_PATH,'>',3),'>',-1)) ELSE NULL END,'') ORGN_NM3
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 4 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_CODE_PATH,'>',4),'>',-1)) ELSE NULL END,'') ORGN_CODE4
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 4 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_NM_PATH,'>',4),'>',-1)) ELSE NULL END,'') ORGN_NM4
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 5 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_CODE_PATH,'>',5),'>',-1)) ELSE NULL END,'') ORGN_CODE5
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 5 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_NM_PATH,'>',5),'>',-1)) ELSE NULL END,'') ORGN_NM5
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 6 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_CODE_PATH,'>',6),'>',-1)) ELSE NULL END,'') ORGN_CODE6
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 6 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_NM_PATH,'>',6),'>',-1)) ELSE NULL END,'') ORGN_NM6
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 7 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_CODE_PATH,'>',7),'>',-1)) ELSE NULL END,'') ORGN_CODE7
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 7 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_NM_PATH,'>',7),'>',-1)) ELSE NULL END,'') ORGN_NM7
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 8 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_CODE_PATH,'>',8),'>',-1)) ELSE NULL END,'') ORGN_CODE8
				,IFNULL(CASE WHEN T1.ORGN_LEV >= 8 THEN TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(T1.ORGN_NM_PATH,'>',8),'>',-1)) ELSE NULL END,'') ORGN_NM8
				,T1.ORGN_CODE_PATH
