					WHEN A.ORGN_LEV = 5 THEN SUM(A.DAY_N00_PCIC_ATCM_Y) OVER (PARTITION BY A.ORGN_CODE5)
					WHEN A.ORGN_LEV = 6 THEN SUM(A.DAY_N00_PCIC_ATCM_Y) OVER (PARTITION BY A.ORGN_CODE6)
					WHEN A.ORGN_LEV = 7 THEN SUM(A.DAY_N00_PCIC_ATCM_Y) OVER (PARTITION BY A.ORGN_CODE7)
					END DAY_N00_PCIC_ATCM_Y
				 ,CASE
					WHEN A.ORGN_LEV = 1 THEN SUM(A.DAY_N00_PCIC_ATCM_N) OVER (PARTITION BY A.ORGN_CODE1)
					WHEN A.ORGN_LEV = 2 THEN SUM(A.DAY_N00_PCIC_ATCM_N) OVER (PARTITION BY A.ORGN_CODE2)
					WHEN A.ORGN_LEV = 3 THEN SUM(A.DAY_N00_PCIC_ATCM_N) OVER (PARTITION BY A.ORGN_CODE3)
					WHEN A.ORGN_LEV = 4 THEN SUM(A.DAY_N00_PCIC_ATCM_N) OVER (PARTITION BY A.ORGN_CODE4)
					WHEN A.ORGN_LEV = 5 THEN SUM(A.DAY_N00_PCIC_ATCM_N) OVER (PARTITION BY A.ORGN_CODE5)
					WHEN A.ORGN_LEV = 6 THEN SUM(A.DAY_N00_PCIC_ATCM_N) OVER (PARTITION BY A.ORGN_CODE6)
					WHEN A.ORGN_LEV = 7 THEN SUM(A.DAY_N00_PCIC_ATCM_N) OVER (PARTITION BY A.ORGN_CODE7)
					END DAY_N00_PCIC_ATCM_N
				 ,CASE
					WHEN A.ORGN_LEV = 1 THEN SUM(A.DAY_N00_PCIC_REF_N) OVER (PARTITION BY A.ORGN_CODE1)
					WHEN A.ORGN_LEV = 2 THEN SUM(A.DAY_N00_PCIC_REF_N) OVER (PARTITION BY A.ORGN_CODE2)
					WHEN A.ORGN_LEV = 3 THEN SUM(A.DAY_N00_PCIC_REF_N) OVER (PARTITION BY A.ORGN_CODE3)
					WHEN A.ORGN_LEV = 4 THEN SUM(A.DAY_N00_PCIC_REF_N) OVER (PARTITION BY A.ORGN_CODE4)
					WHEN A.ORGN_LEV = 5 THEN SUM(A.DAY_N00_PCIC_REF_N) OVER (PARTITION BY A.ORGN_CODE5)
					WHEN A.ORGN_LEV = 6 THEN SUM(A.DAY_N00_PCIC_REF_N) OVER (PARTITION BY A.ORGN_CODE6)
					WHEN A.ORGN_LEV = 7 THEN SUM(A.DAY_N00_PCIC_REF_N) OVER (PARTITION BY A.ORGN_CODE7)
					END DAY_N00_PCIC_REF_N
			FROM ORG_CNTC_INFO A

		)

		SELECT
			CAST(IFNULL(T1.ORGN_CODE_PATH,'') AS CHAR) AS ORGN_CODE_PATH
			,CAST(IFNULL(T1.HGRN_ORGN_CODE,'') AS CHAR) AS HGRN_ORGN_CODE
			,CAST(IFNULL(T1.ORGN_CODE,'') AS CHAR) AS ORGN_CODE
			,CAST(IFNULL(T1.ORGN_NM,'') AS CHAR) AS ORGN_NM
			,CAST(T1.ORGN_LEV AS CHAR) AS ORGN_LEV

			,CAST(T1.ACML_TOT_CNT AS CHAR) AS ACML_TOT_CNT

			,CAST(T1.ACML_TOT_PCIC_BLNG_Y AS CHAR) AS ACML_TOT_PCIC_BLNG_Y
			,CAST(T1.ACML_TOT_PCIC_ATCM_Y AS CHAR) AS ACML_TOT_PCIC_ATCM_Y
			,CAST(T1.ACML_TOT_PCIC_ATCM_N AS CHAR) AS ACML_TOT_PCIC_ATCM_N
			,CAST(IF(T1.ACML_TOT_PCIC_BLNG_Y = 0, 0.0000, T1.ACML_TOT_PCIC_ATCM_Y/T1.ACML_TOT_PCIC_BLNG_Y*100) AS CHAR) AS ACML_TOT_BLNG_RATE
			,CAST(T1.ACML_TOT_PCIC_REF_N AS CHAR) AS ACML_TOT_PCIC_REF_N
			,CAST(IF(T1.ACML_TOT_PCIC_BLNG_Y = 0, 0.0000, T1.ACML_TOT_PCIC_REF_N/T1.ACML_TOT_PCIC_BLNG_Y*100) AS CHAR) AS ACML_TOT_APP_RATE

			,CAST(T1.ACML_L00_PCIC_BLNG_Y AS CHAR) AS ACML_L00_PCIC_BLNG_Y
			,CAST(T1.ACML_L00_PCIC_ATCM_Y AS CHAR) AS ACML_L00_PCIC_ATCM_Y
			,CAST(T1.ACML_L00_PCIC_ATCM_N AS CHAR) AS ACML_L00_PCIC_ATCM_N
			,CAST(IF(T1.ACML_L00_PCIC_BLNG_Y = 0, 0.0000, T1.ACML_L00_PCIC_ATCM_Y/T1.ACML_L00_PCIC_BLNG_Y*100) AS CHAR) AS ACML_L00_BLNG_RATE
			,CAST(T1.ACML_L00_PCIC_REF_N AS CHAR) AS ACML_L00_PCIC_REF_N
			,CAST(IF(T1.ACML_L00_PCIC_BLNG_Y = 0, 0.0000, T1.ACML_L00_PCIC_REF_N/T1.ACML_L00_PCIC_BLNG_Y*100) AS CHAR) AS ACML_L00_APP_RATE

			,CAST(T1.ACML_N00_PCIC_BLNG_Y AS CHAR) AS ACML_N00_PCIC_BLNG_Y
			,CAST(T1.ACML_N00_PCIC_ATCM_Y AS CHAR) AS ACML_N00_PCIC_ATCM_Y
			,CAST(T1.ACML_N00_PCIC_ATCM_N AS CHAR) AS ACML_N00_PCIC_ATCM_N
			,CAST(IF(T1.ACML_N00_PCIC_BLNG_Y = 0, 0.0000, T1.ACML_N00_PCIC_ATCM_Y/T1.ACML_N00_PCIC_BLNG_Y*100) AS CHAR) AS ACML_N00_BLNG_RATE
			,CAST(T1.ACML_N00_PCIC_REF_N AS CHAR) AS ACML_N00_PCIC_REF_N
			,CAST(IF(T1.ACML_N00_PCIC_BLNG_Y = 0, 0.0000, T1.ACML_N00_PCIC_REF_N/T1.ACML_N00_PCIC_BLNG_Y*100) AS CHAR) AS ACML_N00_APP_RATE

			,CAST(T2.DAY_TOT_CNT AS CHAR) AS DAY_TOT_CNT

			,CAST(T2.DAY_TOT_PCIC_BLNG_Y AS CHAR) AS DAY_TOT_PCIC_BLNG_Y
			,CAST(T2.DAY_TOT_PCIC_ATCM_Y AS CHAR) AS DAY_TOT_PCIC_ATCM_Y
			,CAST(T2.DAY_TOT_PCIC_ATCM_N AS CHAR) AS DAY_TOT_PCIC_ATCM_N
			,CAST(IF(T2.DAY_TOT_PCIC_BLNG_Y = 0, 0.0000, T2.DAY_TOT_PCIC_ATCM_Y/T2.DAY_TOT_PCIC_BLNG_Y*100) AS CHAR) AS DAY_TOT_BLNG_RATE
			,CAST(T2.DAY_TOT_PCIC_REF_N AS CHAR) AS DAY_TOT_PCIC_REF_N
			,CAST(IF(T2.DAY_TOT_PCIC_BLNG_Y = 0, 0.0000, T2.DAY_TOT_PCIC_REF_N/T2.DAY_TOT_PCIC_BLNG_Y*100) AS CHAR) AS DAY_TOT_APP_RATE

			,CAST(T2.DAY_L00_PCIC_BLNG_Y AS CHAR) AS DAY_L00_PCIC_BLNG_Y
			,CAST(T2.DAY_L00_PCIC_ATCM_Y AS CHAR) AS DAY_L00_PCIC_ATCM_Y
			,CAST(T2.DAY_L00_PCIC_ATCM_N AS CHAR) AS DAY_L00_PCIC_ATCM_N
			,CAST(IF(T2.DAY_L00_PCIC_BLNG_Y = 0, 0.0000, T2.DAY_L00_PCIC_ATCM_Y/T2.DAY_L00_PCIC_BLNG_Y*100) AS CHAR) AS DAY_L00_BLNG_RATE
			,CAST(T2.DAY_L00_PCIC_REF_N AS CHAR) AS DAY_L00_PCIC_REF_N
			,CAST(IF(T2.DAY_L00_PCIC_BLNG_Y = 0, 0.0000, T2.DAY_L00_PCIC_REF_N/T2.DAY_L00_PCIC_BLNG_Y*100) AS CHAR) AS DAY_L00_APP_RATE

			,CAST(T2.DAY_N00_PCIC_BLNG_Y AS CHAR) AS DAY_N00_PCIC_BLNG_Y
			,CAST(T2.DAY_N00_PCIC_ATCM_Y AS CHAR) AS DAY_N00_PCIC_ATCM_Y
			,CAST(T2.DAY_N00_PCIC_ATCM_N AS CHAR) AS DAY_N00_PCIC_ATCM_N
			,CAST(IF(T2.DAY_N00_PCIC_BLNG_Y = 0, 0.0000, T2.DAY_N00_PCIC_ATCM_Y/T2.DAY_N00_PCIC_BLNG_Y*100) AS CHAR) AS DAY_N00_BLNG_RATE
			,CAST(T2.DAY_N00_PCIC_REF_N AS CHAR) AS DAY_N00_PCIC_REF_N
			,CAST(IF(T2.DAY_N00_PCIC_BLNG_Y = 0, 0.0000, T2.DAY_N00_PCIC_REF_N/T2.DAY_N00_PCIC_BLNG_Y*100) AS CHAR) AS DAY_N00_APP_RATE

		FROM ACML_TABLE T1
		LEFT JOIN DAY_TABLE T2
		ON T1.ORGN_CODE = T2.ORGN_CODE
		INNER JOIN TB_SMHO0002V T3
		ON T1.ORGN_CODE = T3.ORGN_CODE
		AND T3.CLSN_YYMM = LEFT(?, 6)
		AND T3.USE_YN = 'Y'
		ORDER BY T3.LVL1_SORT_ORDR, T3.LVL2_SORT_ORDR, T3.LVL3_SORT_ORDR, T3.LVL4_SORT_ORDR
			, T3.LVL5_SORT_ORDR, T3.LVL6_SORT_ORDR, T3.LVL7_SORT_ORDR, T3.LVL8_SORT_ORDR
