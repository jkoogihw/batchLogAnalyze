2026-08-22 08:06:33.506 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMRM1010.findImsmInfoForRpa */

		 SELECT M.IMSM_MGMT_UUID
				, A.LVL2_ORGN_CODE	AS ORGN_CODE3
				, A.LVL2_ORGN_NM	AS ORGN_NM3
				, A.LVL3_ORGN_CODE 	AS ORGN_CODE4
				, A.LVL3_ORGN_NM	AS ORGN_NM4
				, A.LVL4_ORGN_CODE	AS ORGN_CODE5
				, A.LVL4_ORGN_NM	AS ORGN_NM5
				, A.LVL5_ORGN_CODE	AS ORGN_CODE6
				, A.LVL5_ORGN_NM	AS ORGN_NM6
				, A.LVL6_ORGN_CODE	AS ORGN_CODE7
				, A.LVL6_ORGN_NM	AS ORGN_NM7
				, A.LVL7_ORGN_CODE	AS ORGN_CODE8
				, A.LVL7_ORGN_NM	AS ORGN_NM8
				, M.CNTC_DATE
				, M.RCRT_FP_UNIQ_NO
				, M.RCRT_FP_NM
				, M.POLY_NO
				, M.ISRN_CMPY_CODE
				, (SELECT INTG_DETL_CODE_NM FROM TB_SMCO1502C WHERE INTG_CODE = 'ISRN_CMPY_CODE' AND INTG_DETL_CODE = M.ISRN_CMPY_CODE) AS ISRN_CMPY_NM
				, M.POLR_CUST_ID
				, M.POLR_NM
				, M.INUR_NM
				, M.IMSM_PRGS_STTS_CODE
				, (SELECT INTG_DETL_CODE_NM FROM TB_SMCO1502C WHERE INTG_CODE = 'IMSM_PRGS_STTS_CODE' AND INTG_DETL_CODE = M.IMSM_PRGS_STTS_CODE) AS IMSM_PRGS_STTS_NM
				, M.MEMO_CNTN
				, M.RGST_DTTM
				, M.SELF_CTFN_DTTM
				, M.IMSM_CNFM_RSLT_CODE
				, (SELECT INTG_DETL_CODE_NM FROM TB_SMCO1502C WHERE INTG_CODE = 'IMSM_CNFM_RSLT_CODE' AND INTG_DETL_CODE = M.IMSM_CNFM_RSLT_CODE) AS IMSM_CNFM_RSLT_NM
				, M.IMSM_CUST_CNFM_DATE
				, M.IMSM_LAST_LTRS_SEND_CTNB
				, M.PROD_ID
				, M.PDGR_LGCF_CODE
				, (SELECT INTG_DETL_CODE_NM FROM TB_SMCO1502C WHERE INTG_CODE = 'PDGR_LGCF_CODE' AND INTG_DETL_CODE = M.PDGR_LGCF_CODE) AS PDGR_LGCF_NM
				, M.PDGR_MDCF_CODE
				, (SELECT INTG_DETL_CODE_NM FROM TB_SMCO1502C WHERE INTG_CODE = 'PDGR_MDCF_CODE' AND INTG_DETL_CODE = M.PDGR_MDCF_CODE) AS PDGR_MDCF_NM
				, M.PDGR_SMCF_CODE
				, (SELECT INTG_DETL_CODE_NM FROM TB_SMCO1502C WHERE INTG_CODE = 'PDGR_SMCF_CODE' AND INTG_DETL_CODE = M.PDGR_SMCF_CODE) AS PDGR_SMCF_NM
				, M.PROD_NM
				, M.CNTC_STTS_DETL_CODE
				, (SELECT INTG_DETL_CODE_NM FROM TB_SMCO1502C WHERE INTG_CODE = 'CNTC_STTS_DETL_CODE' AND INTG_DETL_CODE = M.CNTC_STTS_DETL_CODE) AS CNTC_STTS_DETL_NM
				, M.CNTC_STTS_DETL_CODE_RM
				, (SELECT INTG_DETL_CODE_NM FROM TB_SMCO1502C WHERE INTG_CODE = 'CNTC_STTS_DETL_CODE' AND INTG_DETL_CODE = M.CNTC_STTS_DETL_CODE_RM) AS CNTC_STTS_DETL_NM_RM
				, M.SUM_PREM
				, M.PAYM_CYCL_CODE
				, (SELECT INTG_DETL_CODE_NM FROM TB_SMCO1502C WHERE INTG_CODE = 'PAYM_CYCL_CODE' AND INTG_DETL_CODE = M.PAYM_CYCL_CODE) AS PAYM_CYCL_NM
				, M.DOCT_AGRM_APRV_CODE
				, IF(M.DOCT_AGRM_APRV_CODE = '01','스캔','미스캔') AS DOCT_AGRM_SCAN_DVSN_NM
		   FROM (
				 SELECT R10.IMSM_MGMT_UUID
						, P01.RCRT_FP_UNIQ_NO
						, P01.RCRT_FP_NM
						, P01.POLR_CUST_ID
						, P01.POLR_NM
						, P01.INUR_NM
						, P01.CNTC_DATE
						, P01.POLY_NO
						, P01.ISRN_CMPY_CODE
						, R10.POLR_TLNO
						, H10.ORGN_CODE
						, R10.IMSM_PRGS_STTS_CODE
						, R10.MEMO_CNTN
						, R10.RGST_DTTM
						, R10.SELF_CTFN_DTTM
						, R10.IMSM_CNFM_RSLT_CODE
						, R10.IMSM_CUST_CNFM_DATE
						, R10.IMSM_LAST_LTRS_SEND_CTNB
						, P01.PROD_ID
						, P01.PDGR_LGCF_CODE
						, P01.PDGR_MDCF_CODE
						, P01.PDGR_SMCF_CODE
						, P01.PROD_NM
						, P01.CNTC_STTS_CODE
						, P01.CNTC_STTS_DETL_CODE
						, R10.CNTC_STTS_DETL_CODE AS CNTC_STTS_DETL_CODE_RM
						, P01.SUM_PREM
						, P01.PAYM_CYCL_CODE
						, R10.DOCT_AGRM_APRV_CODE
				   FROM TB_SMRM1010 R10
					 INNER JOIN TB_SMPM0101 P01
							 ON P01.POLY_NO = R10.POLY_NO
							AND P01.ISRN_CMPY_CODE = R10.ISRN_CMPY_CODE
					 INNER JOIN TB_SMHO1001 H10
							 ON H10.UNIQ_NO = P01.RCRT_FP_UNIQ_NO
				  WHERE 1=1
					AND H10.DLTN_YN = 'N'
					-- 계약일자
					AND P01.CNTC_DATE BETWEEN  DATE_FORMAT(DATE_SUB(?, INTERVAL 1 MONTH ), '%Y-%m-01') AND DATE_FORMAT(?, '%Y-%m-%d')
			 
					-- 서면동의승인코드
					AND R10.DOCT_AGRM_APRV_CODE = ?
			 
					AND IFNULL(R10.IMSM_CNFM_RSLT_CODE, '20') != '01'	/*불완전판매모니터링 확인 결과 '예'가 아닌 건*/
				) AS M
			 INNER JOIN TB_SMHO0002V A
					 ON A.CLSN_YYMM = DATE_FORMAT(STR_TO_DATE(?, '%Y%m%d'), '%Y%m')
					AND M.ORGN_CODE = A.ORGN_CODE
		  LIMIT ?, ?
