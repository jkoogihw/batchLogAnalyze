					 , SELF_CTFN_DTTM
					 , IMSM_LAST_LTRS_SEND_CTNB
					 , RCRT_FP_NM
					 , POLR_NAME
					 , PROD_NM
					 , SUM_PREM
					 , RCRT_FP_TLNO
				FROM(
				      select H.IMSM_SEND_HIST_UUID
				         , H.IMSM_SEND_CTNB
				    	 , H.SMS_SEND_DTTM
				    	 , H.SMS_SEND_PRGS_STTS_CODE
				    	 , H.SMS_SEND_THEN_STTS_CODE
				    	 , H.VALD_YN
				    	 , H.MEMO_CNTN
						 , I.IMSM_MGMT_UUID AS IMSM_MGMT_UUID
						 , I.POLY_NO AS POLY_NO
						 , I.ISRN_CMPY_CODE AS ISRN_CMPY_CODE
						 , I.IMSM_PRGS_STTS_CODE AS IMSM_PRGS_STTS_CODE
						 , '--' AS POLR_TLNO
				         ,(
					           SELECT CONCAT(D.HP_BSMN_NO, '-', D.HP_OFNO, '-', D.HP_INNO)
					             FROM (
					               SELECT C.RCRT_FP_UNIQ_NO as FP_UNIQ_NO, C08.CUST_NM, IFNULL(NULLIF(C08.HP_BSMN_NO, ""), C2.HP_BSMN_NO) AS HP_BSMN_NO, IFNULL(NULLIF(C08.HP_OFNO, ""), C2.HP_OFNO) AS HP_OFNO, IFNULL(NULLIF(C08.HP_INNO, ""), C2.HP_INNO) AS HP_INNO
				                    FROM TB_SMHO1001 H1
				                   inner join TB_SMHO1002 H2
				                      on H1.UNIQ_NO = C.RCRT_FP_UNIQ_NO
				                     and H2.PSAF_ID = H1.PSAF_ID
				                     and H2.ISRN_CMPY_CODE = C.ISRN_CMPY_CODE
				                   inner join TB_SMCR0801 C08
				                      on C08.CPCP_FP_UNIQ_NO = H2.CPCP_FP_UNIQ_NO
				                     and C08.CPCP_CUST_ID = C.POLR_CUST_ID
				                    LEFT JOIN TB_SMCR0501 C1
				                      ON C1.FP_UNIQ_NO = H1.UNIQ_NO
				                      AND C1.CPCP_CUST_ID = C.POLR_CUST_ID
				                      AND C1.ISRN_CMPY_CODE = 'L01'
				                      AND C1.CUST_ID IS NOT NULL
				                      AND C1.FP_UNIQ_NO IS NOT NULL
				                      AND C1.CPCP_CUST_ID IS NOT NULL
				                    LEFT JOIN TB_SMCR0101 C2
				                      ON C2.FP_UNIQ_NO = C1.FP_UNIQ_NO
				                      AND C2.CUST_ID = C1.CUST_ID
				                      AND C2.FP_UNIQ_NO IS NOT NULL
				                      AND C2.CUST_ID IS NOT NULL
					             ) D
					             LIMIT 1
				          ) AS CR_POLR_TLNO
						 , I.IMSM_CNFM_RSLT_CODE AS IMSM_CNFM_RSLT_CODE
						 , I.IMSM_CUST_CNFM_DATE AS IMSM_CUST_CNFM_DATE
						 , I.SELF_CTFN_DTTM AS SELF_CTFN_DTTM
						 , I.IMSM_LAST_LTRS_SEND_CTNB AS IMSM_LAST_LTRS_SEND_CTNB
						 , C.RCRT_FP_NM AS RCRT_FP_NM
						 , C.POLR_NM AS POLR_NAME
						 , C.PROD_NM AS PROD_NM
						 , C.SUM_PREM AS SUM_PREM
						 , HO.HPNO AS RCRT_FP_TLNO
				      from tb_smrm1011 H
					 inner join tb_smrm1012 M
					    on H.IMSM_SEND_HIST_UUID = M.IMSM_SEND_HIST_UUID
					 inner join tb_smrm1010 I
					    on M.IMSM_MGMT_UUID = I.IMSM_MGMT_UUID
					 inner join tb_smpm0101 C
					    on I.POLY_NO = C.POLY_NO
					   and I.ISRN_CMPY_CODE = C.ISRN_CMPY_CODE
					 inner join tb_smho1001 HO
					    on C.RCRT_FP_UNIQ_NO = HO.UNIQ_NO
				     where H.SMS_SEND_PRGS_STTS_CODE = ?
				 ) TT
				 WHERE CR_POLR_TLNO IS NULL
			)
			UPDATE TB_SMRM1010
