2026-08-21 11:06:48.508 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMRM1010.updateSMSTargetListToSendStatus */

	WITH RDATA AS (
		SELECT A.IMSM_MGMT_UUID , A.IMSM_SEND_HIST_UUID
		  FROM TB_SMRM1012 A
		 INNER JOIN TB_SMRM1010 B
		    ON A.IMSM_MGMT_UUID = B.IMSM_MGMT_UUID
		 INNER JOIN TB_SMRM1011 C
		    ON A.IMSM_SEND_HIST_UUID = C.IMSM_SEND_HIST_UUID
		 WHERE C.SMS_SEND_PRGS_STTS_CODE = '20'
		   AND B.IMSM_PRGS_STTS_CODE = '00'
	)
	UPDATE TB_SMRM1010
	   SET IMSM_PRGS_STTS_CODE = '01'
	   	 , IMSM_LAST_LTRS_SEND_CTNB = (IMSM_LAST_LTRS_SEND_CTNB +1)
	   	 , LAST_CHNG_PRGM_ID = 'SmrmJob103002Tasklet'
	     , LAST_CHNG_USER_ID = 'Batch'
	     , LAST_CHNG_DTTM = NOW()
	 WHERE IMSM_MGMT_UUID IN (SELECT IMSM_MGMT_UUID FROM RDATA)
