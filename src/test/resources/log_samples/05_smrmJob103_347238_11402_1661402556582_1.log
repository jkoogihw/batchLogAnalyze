2026-08-21 11:06:34.167 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMRM1011.selectSpecifiedStatusList */

   	SELECT
	   IMSM_SEND_HIST_UUID
         , IMSM_SEND_CTNB
    	 , SMS_SEND_DTTM
    	 , SMS_SEND_PRGS_STTS_CODE
    	 , SMS_SEND_THEN_STTS_CODE
    	 , VALD_YN
    	 , MEMO_CNTN
    	 , RGST_USER_ID
    	 , RGST_DTTM
    	 , RGST_PRGM_ID
    	 , LAST_CHNG_USER_ID
    	 , LAST_CHNG_DTTM
    	 , LAST_CHNG_PRGM_ID
		 , 00_IMSM_MGMT_UUID
		 , 00_POLY_NO
		 , 00_ISRN_CMPY_CODE
		 , 00_IMSM_PRGS_STTS_CODE
		 , 00_MEMO_CNTN
		 , 00_POLR_TLNO
         , 00_CR_POLR_TLNO
		 , 00_IMSM_CNFM_RSLT_CODE
		 , 00_IMSM_CUST_CNFM_DATE
		 , 00_SELF_CTFN_DTTM
		 , 00_IMSM_LAST_LTRS_SEND_CTNB
		 , 00_RGST_USER_ID
		 , 00_RGST_DTTM
		 , 00_RGST_PRGM_ID
		 , 00_LAST_CHNG_USER_ID
		 , 00_LAST_CHNG_DTTM
		 , 00_LAST_CHNG_PRGM_ID
		 , 00_RCRT_FP_NM
		 , 00_ISRN_CMPY_NAME
		 , 00_POLR_NAME
		 , 00_PROD_NM
		 , 00_SUM_PREM
		 , 00_RCRT_FP_TLNO
	FROM(
	      select H.IMSM_SEND_HIST_UUID
	         , H.IMSM_SEND_CTNB
	    	 , H.SMS_SEND_DTTM
	    	 , H.SMS_SEND_PRGS_STTS_CODE
	    	 , H.SMS_SEND_THEN_STTS_CODE
	    	 , H.VALD_YN
	    	 , H.MEMO_CNTN
	    	 , H.RGST_USER_ID
	    	 , H.RGST_DTTM
	    	 , H.RGST_PRGM_ID
	    	 , H.LAST_CHNG_USER_ID
	    	 , H.LAST_CHNG_DTTM
	    	 , H.LAST_CHNG_PRGM_ID
			 , I.IMSM_MGMT_UUID AS 00_IMSM_MGMT_UUID
			 , I.POLY_NO AS 00_POLY_NO
			 , I.ISRN_CMPY_CODE AS 00_ISRN_CMPY_CODE
			 , I.IMSM_PRGS_STTS_CODE AS 00_IMSM_PRGS_STTS_CODE
			 , I.MEMO_CNTN AS 00_MEMO_CNTN
			 , '--' AS 00_POLR_TLNO
	         ,(
		           SELECT CONCAT(D.HP_BSMN_NO, '-', D.HP_OFNO, '-', D.HP_INNO)
		             FROM (
		               SELECT C.RCRT_FP_UNIQ_NO as FP_UNIQ_NO, C08.CUST_NM, IFNULL(NULLIF(C08.HP_BSMN_NO, ""), C2.HP_BSMN_NO) AS HP_BSMN_NO, IFNULL(NULLIF(C08.HP_OFNO, ""), C2.HP_OFNO) AS HP_OFNO, IFNULL(NULLIF(C08.HP_INNO, ""), C2.HP_INNO) AS HP_INNO
	                    FROM TB_SMHO1001 H1
	                   inner join TB_SMHO1002 H2
	                      on H1.UNIQ_NO = C.RCRT_FP_UNIQ_NO
	                     and H2.PSAF_ID = H1.PSAF_ID
	                     and H2.ISRN_CMPY_CODE = C.ISRN_CMPY_CODE
	                   inner join TB_SMCR0801 C08
	                      on C08.CPCP_FP_UNIQ_NO = H2.CPCP_FP_UNIQ_NO
	                     and C08.CPCP_CUST_ID = C.POLR_CUST_ID
	                    LEFT JOIN TB_SMCR0501 C1
	                      ON C1.FP_UNIQ_NO = H1.UNIQ_NO
	                      AND C1.CPCP_CUST_ID = C.POLR_CUST_ID
	                      AND C1.ISRN_CMPY_CODE = 'L01'
	                      AND C1.CUST_ID IS NOT NULL
	                      AND C1.FP_UNIQ_NO IS NOT NULL
	                      AND C1.CPCP_CUST_ID IS NOT NULL
	                    LEFT JOIN TB_SMCR0101 C2
	                      ON C2.FP_UNIQ_NO = C1.FP_UNIQ_NO
	                      AND C2.CUST_ID = C1.CUST_ID
	                      AND C2.FP_UNIQ_NO IS NOT NULL
	                      AND C2.CUST_ID IS NOT NULL
		             ) D
		             LIMIT 1
	          ) AS 00_CR_POLR_TLNO
			 , I.IMSM_CNFM_RSLT_CODE AS 00_IMSM_CNFM_RSLT_CODE
			 , I.IMSM_CUST_CNFM_DATE AS 00_IMSM_CUST_CNFM_DATE
			 , I.SELF_CTFN_DTTM AS 00_SELF_CTFN_DTTM
			 , I.IMSM_LAST_LTRS_SEND_CTNB AS 00_IMSM_LAST_LTRS_SEND_CTNB
			 , I.RGST_USER_ID AS 00_RGST_USER_ID
			 , I.RGST_DTTM AS 00_RGST_DTTM
			 , I.RGST_PRGM_ID AS 00_RGST_PRGM_ID
			 , I.LAST_CHNG_USER_ID AS 00_LAST_CHNG_USER_ID
			 , I.LAST_CHNG_DTTM AS 00_LAST_CHNG_DTTM
			 , I.LAST_CHNG_PRGM_ID AS 00_LAST_CHNG_PRGM_ID
			 , C.RCRT_FP_NM AS 00_RCRT_FP_NM
			 , CM.INTG_DETL_CODE_NM AS 00_ISRN_CMPY_NAME
			 , C.POLR_NM AS 00_POLR_NAME
			 , C.PROD_NM AS 00_PROD_NM
			 , C.SUM_PREM AS 00_SUM_PREM
			 , HO.HPNO AS 00_RCRT_FP_TLNO
	      from tb_smrm1011 H
		 inner join tb_smrm1012 M
		    on H.IMSM_SEND_HIST_UUID = M.IMSM_SEND_HIST_UUID
		 inner join tb_smrm1010 I
		    on M.IMSM_MGMT_UUID = I.IMSM_MGMT_UUID
		 inner join tb_smpm0101 C
		    on I.POLY_NO = C.POLY_NO
		   and I.ISRN_CMPY_CODE = C.ISRN_CMPY_CODE
		 inner join tb_smco1502c CM
		    on CM.INTG_CODE = 'ISRN_CMPY_CODE'
		   and C.ISRN_CMPY_CODE = CM.INTG_DETL_CODE
		 inner join tb_smho1001 HO
		    on C.RCRT_FP_UNIQ_NO = HO.UNIQ_NO
	     where H.SMS_SEND_PRGS_STTS_CODE = ?
	 ) TT
	 WHERE 00_CR_POLR_TLNO IS NOT NULL

     order by IMSM_SEND_HIST_UUID
     LIMIT ?, ?
