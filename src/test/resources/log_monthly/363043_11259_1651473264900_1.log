			, A.RGST_PRGM_ID
			, A.LAST_CHNG_USER_ID
			, A.LAST_CHNG_DTTM
			, A.LAST_CHNG_PRGM_ID
	FROM TB_SMPM0601 A
	LEFT JOIN (
		SELECT 	  A.PROD_ID
				, MAX(A.HIST_SQNO) AS HIST_SQNO
		FROM TB_SMPM0601H A
		GROUP BY A.PROD_ID
	) HM ON A.PROD_ID = HM.PROD_ID
	LEFT JOIN TB_SMPM0601H H ON H.PROD_ID = HM.PROD_ID AND H.HIST_SQNO = HM.HIST_SQNO
	WHERE 1=1
	AND (
		   NOT(A.PROD_NM                     <=>   H.PROD_NM                  )
		OR NOT(A.PROD_ABRV_NM                <=>   H.PROD_ABRV_NM             )
		OR NOT(A.SUMM_PROD_NM                <=>   H.SUMM_PROD_NM             )
		OR NOT(A.PROD_ISTC                   <=>   H.PROD_ISTC                )
