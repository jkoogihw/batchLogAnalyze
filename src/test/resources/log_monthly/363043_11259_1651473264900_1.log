			 UPDATE TB_SMPM0601
                SET PROD_NM = ?
                    , PROD_ABRV_NM = REPLACE(?, ' ', '')
                    , SUMM_PROD_NM = ?
                    , PROD_ISTC = ?
... [TRIMMED 1 LINES] ...
			, A.PROD_CMPR_TRGT_YN
			, A.PCIC_CODE
			, A.ASOC_PROD_CODE
			, A.ASOC_PROD_CHNG_DTTM
			, A.INPT_MTHD_DVSN_CODE
			, A.USE_YN
