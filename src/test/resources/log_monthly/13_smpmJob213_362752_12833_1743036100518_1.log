		    , RGST_PRGM_ID
		    , LAST_CHNG_USER_ID
		    , LAST_CHNG_DTTM
		    , LAST_CHNG_PRGM_ID
		)
		SELECT
			T1.ISRN_CMPY_CODE
		    , T1.POLY_NO
		    , T1.CNTC_DATE
		    , 0
		    , T1.RCRT_FP_UNIQ_NO
		    , T1.RCRT_FP_NM
		    , T1.RCRT_FP_ORGN_CODE
		    , T1.RCRT_FP_ORGN_NM
		    , T1.RCRT_FP_OGZT_CODE
		    , T1.POLR_NM
		    , 'pm213001Tasklet'
		    , NOW()
		    , 'pm213001Tasklet_ins'
		    , 'pm213001Tasklet'
		    , NOW()
		    , 'pm213001Tasklett_ins'
		FROM
		(
			 
		SELECT
			Z.POLY_NO
			, Z.ISRN_CMPY_CODE
			, Z.CNTC_DATE
			, Z.PCIC_BLNG_YN /*상품비교설명확인서 대상여부*/
			, CASE WHEN Z.PCIC_BLNG_YN = 'N' THEN 'X' 									/* X, 비대상(징구제외대상)*/
				  WHEN Z.PCIC_BLNG_YN = 'Y' AND Z.ATCM_FILE_ID IS NOT NULL THEN 'Y' 	/* Y, 첨부파일 등록*/
				  ELSE 'N' 																/* N, 첨부파일 미등록*/
			      END AS PCIC_ATCM_YN /*상품비교설명확인서 등록여부*/						/* Z(계약없음)*/
			, CASE WHEN Z.PCIC_BLNG_YN = 'N' THEN 'X' 																							/* X, 비대상(징구제외대상)*/
				  WHEN Z.PCIC_BLNG_YN = 'Y' AND Z.ATCM_FILE_ID IS NOT NULL AND Z.APPN_MTHD_CODE = '01' THEN 'N' 								/* N, 비대상(전자징구), 전자*/
				  WHEN Z.PCIC_BLNG_YN = 'Y' AND Z.ATCM_FILE_ID IS NOT NULL AND (Z.APPN_MTHD_CODE = '02' OR Z.APPN_MTHD_CODE = '03') THEN 'Y'    /* Y, 편철대상, 종이*/
				  ELSE 'Z' 																														/* Z, 알수없음, 대상이지만 첨부파일 없어서 미정*/
			      END AS PCIC_REF_YN /*상품비교설명확인서 편철대상, 징구유형*/
			, Z.RCRT_FP_UNIQ_NO
			, Z.RCRT_FP_NM
			, Z.RCRT_FP_ORGN_CODE
			, Z.RCRT_FP_ORGN_NM
			, Z.RCRT_FP_OGZT_CODE
			, Z.POLR_NM
		FROM(
			SELECT
				TE.POLY_NO
				, TE.ISRN_CMPY_CODE
				, TE.CNTC_DATE
				, TE.CNTC_STTS_CODE
				, TE.PDGR_LGCF_CODE
				, TE.RCRT_FP_UNIQ_NO
				, TE.RCRT_FP_NM
				, TE.RCRT_FP_ORGN_CODE
				, TE.RCRT_FP_ORGN_NM
				, TE.RCRT_FP_OGZT_CODE
				, TE.POLR_NM
				, TE3.PROD_CMPR_TRGT_YN
				, TE5.PCIC_BLNG_EXLS_RESN_CODE
			 	, CASE WHEN(TE.CNTC_DATE >= '2025-11-13'					/*서비스 시작일 20251113*/
						AND TE.PDGR_LGCF_CODE IN ('LA','LB','NL','CA') 		/*대분류가 보장성, 연금저축, 장기, 자동차인건 대상에 해당*/
						AND TE.RCRT_FP_UNIQ_NO != 'TRANSFER' 				/*모집FP고유번호가 TRANSFER이면 수금이관건이므로 TRANSFER가 아닌건이 대상에 해당*/
						AND TE3.PROD_CMPR_TRGT_YN = 'Y'						/*상품이 비교대상인 건*/
						AND (TE5.POLY_NO IS NULL OR TE5.PCIC_BLNG_EXLS_RESN_CODE = '00') 							/*상품비교확인서 대상제외 테이블에 없거나 오류로 제외테이블 존재하지만 코드가 00인것 대상에 해당*/
						AND !(TE.PDGR_LGCF_CODE IN ('CA') AND (TE.CNTC_DATE BETWEEN '2022-06-01' AND '2023-06-30')) /*대분류가 자동차이고 계약일자가 20220601~20230630 사이이면 대상건 제외*/
					    )THEN 'Y' ELSE 'N' END AS PCIC_BLNG_YN 														/*비교안내확인서 대상여부*/
				 , CASE WHEN TE5.POLY_NO IS NOT NULL OR TE5.PCIC_BLNG_EXLS_RESN_CODE != '00' THEN 'Y' ELSE 'Z' END AS PCIC_DRCT_EXLS_YN /*상품비교설명확인서 직접 징구제외 여부*/
				, S2.ATCM_FILE_ID
				, S2.APPN_MTHD_CODE
			FROM TB_SMPM0101 TE
			LEFT JOIN TB_SMHO1002 TH1
				ON TH1.ISRN_CMPY_CODE = TE.ISRN_CMPY_CODE
				AND TH1.CPCP_FP_UNIQ_NO = TE.CPCP_RCRT_FP_UNIQ_NO
				AND TH1.DLTN_YN = 'N'
			LEFT JOIN TB_SMPM0601 TE3
				ON (TE3.PROD_ID = TE.PROD_ID)
			LEFT JOIN TB_SMPM0617 TE5
				ON (TE5.POLY_NO = TE.POLY_NO
				AND TE5.ISRN_CMPY_CODE = TE.ISRN_CMPY_CODE)
			LEFT JOIN TB_SMPM0624 S2
				ON S2.DLTN_YN = 'N'
				AND S2.PCIC_ATCM_YN = 'Y'
				AND S2.ISRN_CMPY_CODE = TE.ISRN_CMPY_CODE
				AND S2.POLY_NO = TE.POLY_NO
				AND S2.ATCM_FILE_ID = (SELECT ATCM_FILE_ID FROM TB_SMPM0624 WHERE DLTN_YN = 'N' AND PCIC_ATCM_YN = 'Y' AND ISRN_CMPY_CODE = TE.ISRN_CMPY_CODE AND POLY_NO = TE.POLY_NO LIMIT 1)
			WHERE TE.CNTC_DATE BETWEEN DATE_SUB(STR_TO_DATE(?, '%Y%m%d'), INTERVAL 1 MONTH) AND DATE_SUB(STR_TO_DATE(?, '%Y%m%d'), INTERVAL 2 DAY) /*당일기준 1달전부터 당일-2일전 계약이 대상*/
		    AND TE.CNTC_DATE >= '2025-11-13' /*서비스 시작일 20251113*/
			AND (TE.RCRT_FP_UNIQ_NO IS NOT NULL OR TE.RCRT_FP_UNIQ_NO != '') /*모집FP정보가 없는건 제외*/
		)Z
	 
		) T1
		WHERE 1=1
		AND T1.PCIC_BLNG_YN = 'Y'
		AND T1.PCIC_ATCM_YN = 'N' /*Y,N,X(비대상),Z(계약없음)*/
		ON DUPLICATE KEY UPDATE
			PCIC_ATCM_YN = 'N'
			, CNTC_DATE = T1.CNTC_DATE
		    , RCRT_FP_UNIQ_NO = T1.RCRT_FP_UNIQ_NO
