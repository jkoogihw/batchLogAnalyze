2026-09-01 15:33:44.422 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMPM0626.updatePcicSendCpltSqno */

		UPDATE TB_SMPM0626 A
		LEFT JOIN (
			SELECT
				A.POLY_NO AS POLY_NO
				, A.ISRN_CMPY_CODE AS ISRN_CMPY_CODE
				, COUNT(A.POLY_NO) AS LAST_SQNO
				, B.RCNT_SEND_DTTM
			FROM TB_SMPM0626 A
			INNER JOIN (
				SELECT
					X.ISRN_CMPY_CODE
					, X.POLY_NO
					, X.PCIC_SEND_SQNO
					, X.NTC_SEND_DTTM
					, Y.RCNT_SEND_DTTM
				FROM TB_SMPM0626 X
				INNER JOIN TB_SMPM0625 Y
				ON X.ISRN_CMPY_CODE = Y.ISRN_CMPY_CODE
				AND X.POLY_NO = Y.POLY_NO
				LEFT JOIN TB_SMHO1001 Z
				ON X.RCRT_FP_UNIQ_NO = Z.UNIQ_NO
				WHERE 1=1
				AND X.DLTN_YN = 'N'
				AND X.NTTK_SEND_YN = 'N'
				AND X.PCIC_SEND_SQNO = 0
			) B
			ON A.ISRN_CMPY_CODE = B.ISRN_CMPY_CODE
			AND A.POLY_NO = B.POLY_NO
			WHERE A.DLTN_YN = 'N'
			AND A.NTTK_SEND_YN IN ('Y','N') 	-- NTTK_SEND_YN(X)발송실패한것은 카운트에서 제외
			GROUP BY A.POLY_NO, A.ISRN_CMPY_CODE
		)T1
			ON A.POLY_NO = T1.POLY_NO
			AND A.ISRN_CMPY_CODE = T1.ISRN_CMPY_CODE
		SET
			A.PCIC_SEND_SQNO = T1.LAST_SQNO
			, A.NTC_SEND_DTTM = T1.RCNT_SEND_DTTM
			, A.NTTK_SEND_YN = 'Y'
			, A.LAST_CHNG_USER_ID = 'pm213004Tasklet'
			, A.LAST_CHNG_DTTM = NOW()
			, A.LAST_CHNG_PRGM_ID = 'pm213004Tasklet_sqno'
		WHERE 1=1
		AND A.DLTN_YN = 'N'
		AND A.NTTK_SEND_YN = 'N'
		AND A.PCIC_SEND_SQNO = 0
