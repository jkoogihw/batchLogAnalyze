2026-09-06 09:06:49.757 INFO  [BatchMyBatisLoggingInterceptor.java:47 - intercept] query::/* BATCH_SQL_ID : TB_SMPC0101.findPcicNotReqBlng */

	/* 징구대상 미요청건 목록조회 */
	SELECT TB1.PCIC_MGMT_SQNO       /* 상품비교설명확인서관리일련번호 */
	     , TB1.PCIC_STTS_CODE       /* 상품비교설명확인서상태코드 */
	     , TB1.PCIC_BLNG_STTS_CODE  /* 상품비교설명확인서징구상태코드 */
	     , TB1.FP_UNIQ_NO
	     , TB1.ISRN_CMPY_CODE
	           AS ISRN_CMPY_CODE    /* [보험회사코드] */
	     , TB1.POLY_NO              /* [증권번호] */
	     , (CASE WHEN TB1.PCIC_RGST_DVSN_CODE = '01' THEN '02'
	             WHEN TB1.PCIC_RGST_DVSN_CODE = '02' THEN '01'
	             ELSE '' END) AS APPN_MTHD_CODE      /* 상품비교설명확인서등록구분코드[청약방법코드] - 상비서 등록구분코드 : [01:지류, 02:전자]/계약 청약방법코드 : [01:전자, 02:종이(스켄), 03:종이(사진)] */
	     , TB2.PCIC_ATCM_FILE_NM AS ATCM_FILE_NM     /* 상품비교설명확인서첨부파일명 [첨부파일명]   */
	     , TB2.PCIC_ATCM_FILE_UUID AS ATCM_FILE_ID   /* 상품비교설명확인서첨부파일UUID [첨부파일ID] */
	     , DATE_FORMAT(NOW(), '%Y%m%d') AS DAT_RFDT  /* [데이터기준일자] */
	     , DATE_FORMAT(TB1.LAST_CHNG_DTTM, '%Y%m%d') AS DAT_LDNG_DATE
	                                                 /* [데이터적재일자] (수정일시로 임시적용) */
	  FROM TB_SMPC0101 TB1
	  JOIN (
	        SELECT TB.PCIC_ATCM_FILE_UUID /* 상품비교설명확인서첨부파일UUID */
	             , TB.PCIC_ATCM_FILE_NM   /* 상품비교설명확인서첨부파일명 */
	             , TB.PCIC_MGMT_SQNO      /* 상품비교설명확인서관리일련번호 */
	             , TB.PCIC_RGST_DVSN_CODE /* 상품비교설명확인서등록구분코드 */
	             , TB.PCIC_BLNG_CODE      /* 상품비교설명확인서징구코드 */
	             , TB.DLTN_YN             /* 삭제여부 */
	             , TB.RGST_DTTM           /* 등록일시 */
	             , ROW_NUMBER() OVER(     /* 첨부파일 여러건인 경우 최종등록일 대상으로 조회 */
	                   PARTITION BY TB.PCIC_MGMT_SQNO
	                       ORDER BY TB.RGST_DTTM DESC
	               ) AS rn
... [TRIMMED 1 LINES] ...
	   AND TB1.PCIC_STTS_CODE IN ('20') /* 00:생성완료, 10:서명대기, 20:서명완료, 30:최종완료*/
	   AND TB1.PCIC_BLNG_STTS_CODE IN ('10', '20')   /* 10:요청(온라인실패), 20:실패, 30:완료*/
	   AND TB1.RGST_DTTM  >=  DATE_SUB(NOW(), INTERVAL 7 DAY)  /* 배치실패건 무한누적 회피조건 */
	   AND TB1.POLY_NO IS NOT null
	   AND TB2.PCIC_ATCM_FILE_UUID IS NOT NULL
